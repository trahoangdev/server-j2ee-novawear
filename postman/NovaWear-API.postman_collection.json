{
	"info": {
		"_postman_id": "novawear-j2ee-api",
		"name": "NovaWear API",
		"description": "Collection test API backend NovaWear J2EE (Spring Boot).\n\n**Setup:**\n1. Biến `baseUrl`: http://localhost:8080\n2. Gọi **Auth > Login** (admin/admin123) hoặc **Register** → token tự lưu vào biến `token`\n3. Các request cần đăng nhập dùng header Authorization: Bearer {{token}}",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "token", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('token', json.token);",
									"        console.log('Token saved to collection variable: token');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login",
						"description": "Đăng nhập. Token trả về sẽ tự lưu vào biến `token`."
					}
				},
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    console.log('Register OK - use Login to get token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"user1\",\n  \"password\": \"password123\",\n  \"email\": \"user1@example.com\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/register",
						"description": "Đăng ký tài khoản USER."
					}
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": "{{baseUrl}}/api/auth/me",
						"description": "Lấy thông tin user đang đăng nhập. Cần token."
					}
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "Get all categories",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/categories",
						"description": "Public - không cần token."
					}
				},
				{
					"name": "Get category by id",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/categories/1",
						"description": "Public."
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get products (list)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products?page=0&size=12",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products"],
							"query": [
								{ "key": "categoryId", "value": "", "disabled": true },
								{ "key": "search", "value": "", "disabled": true },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "12" }
							]
						},
						"description": "Public. Có thể bật categoryId hoặc search."
					}
				},
				{
					"name": "Get featured products",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/products/featured",
						"description": "Public - 8 sản phẩm mới nhất."
					}
				},
				{
					"name": "Get product by id",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/products/1",
						"description": "Public."
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get cart",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/cart",
						"description": "Cần token (USER/ADMIN)."
					}
				},
				{
					"name": "Add to cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
						},
						"url": "{{baseUrl}}/api/cart/add",
						"description": "Thêm sản phẩm vào giỏ. Cần token."
					}
				},
				{
					"name": "Update cart item quantity",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/cart/items/1?quantity=3",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "items", "1"],
							"query": [{ "key": "quantity", "value": "3" }]
						},
						"description": "Cập nhật số lượng. productId=1, quantity=3. Cần token."
					}
				},
				{
					"name": "Remove from cart",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/cart/items/1",
						"description": "Xóa sản phẩm khỏi giỏ (productId=1). Cần token."
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "My orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/orders?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "orders"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						},
						"description": "Danh sách đơn hàng của user. Cần token."
					}
				},
				{
					"name": "Get order by id",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/orders/1",
						"description": "Cần token."
					}
				},
				{
					"name": "Checkout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentMethod\": \"PAYPAL\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 2, \"quantity\": 1 }\n  ]\n}"
						},
						"url": "{{baseUrl}}/api/orders/checkout",
						"description": "Tạo đơn hàng và xóa giỏ. paymentMethod: PAYPAL hoặc MOMO. Cần token."
					}
				}
			]
		},
		{
			"name": "Reviews",
			"item": [
				{
					"name": "Get reviews by product",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/reviews/product/1?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "reviews", "product", "1"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						},
						"description": "Public - chỉ đánh giá đã duyệt."
					}
				},
				{
					"name": "Create review",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 5,\n  \"comment\": \"Sản phẩm rất tốt!\"\n}"
						},
						"url": "{{baseUrl}}/api/reviews/product/1",
						"description": "Gửi đánh giá cho productId=1. rating 1-5. Cần token."
					}
				}
			]
		},
		{
			"name": "Admin - Categories",
			"item": [
				{
					"name": "Get all",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/categories",
						"description": "ADMIN."
					}
				},
				{
					"name": "Get by id",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/categories/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Create category",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Áo thun\",\n  \"description\": \"Danh mục áo thun nam nữ\"\n}"
						},
						"url": "{{baseUrl}}/api/admin/categories",
						"description": "ADMIN."
					}
				},
				{
					"name": "Update category",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Áo thun cập nhật\",\n  \"description\": \"Mô tả mới\"\n}"
						},
						"url": "{{baseUrl}}/api/admin/categories/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Delete category",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/categories/1",
						"description": "ADMIN. Chỉ xóa khi không còn sản phẩm thuộc danh mục."
					}
				}
			]
		},
		{
			"name": "Admin - Products",
			"item": [
				{
					"name": "Get by id",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/products/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Create product",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Áo thun basic\",\n  \"price\": 199000,\n  \"description\": \"Chất liệu cotton\",\n  \"imageUrl\": \"https://example.com/ao.jpg\",\n  \"categoryId\": 1,\n  \"stock\": 100\n}"
						},
						"url": "{{baseUrl}}/api/admin/products",
						"description": "ADMIN. categoryId phải tồn tại."
					}
				},
				{
					"name": "Update product",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Áo thun basic (cập nhật)\",\n  \"price\": 219000,\n  \"description\": \"Chất liệu cotton cao cấp\",\n  \"imageUrl\": \"https://example.com/ao2.jpg\",\n  \"categoryId\": 1,\n  \"stock\": 80\n}"
						},
						"url": "{{baseUrl}}/api/admin/products/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Delete product",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/products/1",
						"description": "ADMIN."
					}
				}
			]
		},
		{
			"name": "Admin - Orders",
			"item": [
				{
					"name": "List orders",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/orders?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "orders"],
							"query": [
								{ "key": "status", "value": "PENDING", "disabled": true },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						},
						"description": "ADMIN. Bật query 'status' để lọc: PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED."
					}
				},
				{
					"name": "Get order by id",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/orders/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Update order status",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/orders/1/status?status=CONFIRMED",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "orders", "1", "status"],
							"query": [{ "key": "status", "value": "CONFIRMED" }]
						},
						"description": "ADMIN. status: PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED."
					}
				}
			]
		},
		{
			"name": "Admin - Users",
			"item": [
				{
					"name": "List users",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/users?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						},
						"description": "ADMIN - danh sách khách hàng."
					}
				},
				{
					"name": "Get user by id",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/users/1",
						"description": "ADMIN."
					}
				},
				{
					"name": "Set user active",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/1/active?active=false",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "1", "active"],
							"query": [{ "key": "active", "value": "false" }]
						},
						"description": "ADMIN. active=true/false để bật/tắt tài khoản."
					}
				}
			]
		},
		{
			"name": "Admin - Reviews",
			"item": [
				{
					"name": "List reviews",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/reviews?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "reviews"],
							"query": [
								{ "key": "productId", "value": "1", "disabled": true },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						},
						"description": "ADMIN. Bật productId để lọc theo sản phẩm."
					}
				},
				{
					"name": "Approve review",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/reviews/1/approve?approved=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "reviews", "1", "approve"],
							"query": [{ "key": "approved", "value": "true" }]
						},
						"description": "ADMIN. approved=true/false."
					}
				},
				{
					"name": "Delete review",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{baseUrl}}/api/admin/reviews/1",
						"description": "ADMIN."
					}
				}
			]
		},
		{
			"name": "Admin - Stats",
			"item": [
				{
					"name": "Revenue stats",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/admin/stats/revenue",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "stats", "revenue"],
							"query": [
								{ "key": "from", "value": "2025-01-01", "disabled": true },
								{ "key": "to", "value": "2025-12-31", "disabled": true }
							]
						},
						"description": "ADMIN. Mặc định 30 ngày gần nhất. Bật from/to (YYYY-MM-DD) để tùy chỉnh."
					}
				}
			]
		}
	]
}
